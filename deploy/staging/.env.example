# Public hostname and ACME account email. The A record for STAGING_DOMAIN must
# point at the VPS before Caddy starts so it can obtain the TLS certificate.
STAGING_DOMAIN=staging.triplyy.net
ACME_EMAIL=triplyy.info@gmail.com

# Separate Supabase staging project only. Never copy the production values.
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<staging-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<staging-service-role-key>

# Browser-facing origin and internal service targets.
CORS_ORIGINS=https://staging.triplyy.net
FRONTEND_BASE_URL=https://staging.triplyy.net
BACKEND_INTERNAL_URL=http://api:8000
AI_SERVICE_URL=http://ai:8000
OSRM_URL=http://osrm:5000

# Generate new random values for staging. Do not reuse production secrets.
INTERNAL_SECRET=<staging-internal-secret>
WEBHOOK_SECRET=<staging-webhook-secret>
FRAUD_SIGNAL_HMAC_SECRET=<staging-fraud-hmac-secret>

# Test-only integrations. Keep email sending disabled until a test mailbox is ready.
SUPPORT_EMAIL=triplyy.info@gmail.com
RESEND_API_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
